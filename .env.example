# ============================================================
# SAUVI — Variables d'environnement
# Copier ce fichier en .env dans chaque app et remplir les valeurs
# NE JAMAIS commiter le fichier .env reel en production !
# ============================================================

# ============================================================
# apps/api/.env  — Backend NestJS
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3000

# --- Base de donnees (Supabase PostgreSQL via PgBouncer) ---
# DATABASE_URL : connexion poolee (pgbouncer=true) utilisee par Prisma a runtime
# DIRECT_URL   : connexion directe sans pooler utilisee par Prisma pour les migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Redis (Upstash ou autre) ---
REDIS_URL="rediss://default:YOUR_TOKEN@YOUR_REDIS_HOST:6379"

# --- JWT ---
JWT_SECRET="your-very-long-secret-access-token-min-32-chars"
JWT_REFRESH_SECRET="your-very-long-secret-refresh-token-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="http://YOUR_API_HOST:3000/api/auth/google/callback"

# --- Supabase (Storage / Service role) ---
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SUPABASE_SERVICE_ROLE_JWT"

# --- Firebase Admin SDK (FCM Push Notifications) ---
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
# Coller la cle privee sur UNE SEULE LIGNE en echappant les \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Email (Gmail App Password ou SendGrid) ---
# Option Gmail :
MAIL_PROVIDER="gmail"
FROM_EMAIL="noreply@yourdomain.com"
GMAIL_USER="your.account@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Option SendGrid (commenter Gmail au-dessus si vous utilisez SendGrid) :
# SENDGRID_API_KEY="SG.YOUR_SENDGRID_API_KEY"

# --- Frontend URL (deep-link OAuth Expo / App mobile) ---
FRONTEND_URL="exp://YOUR_LOCAL_IP:8081/--"


# ============================================================
# apps/mobile/.env  — App mobile Expo (React Native)
# ============================================================

# URL de base de l'API backend (sans slash final)
EXPO_PUBLIC_API_URL="http://YOUR_LOCAL_IP:3000/api/"

# Cle Geoapify (geocoding / recherche de ville)
EXPO_PUBLIC_GEOAPIFY_API_KEY="YOUR_GEOAPIFY_API_KEY"


# ============================================================
# apps/landing/.env.local  — Landing Page Next.js (optionnel)
# (uniquement si la landing appelle des API publiques)
# ============================================================

# NEXT_PUBLIC_API_URL="https://api.yourdomain.com"
